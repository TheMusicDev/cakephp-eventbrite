# Copy to .env (gitignored) for local runs — NEVER commit real values.
# Used for live checks against a real Eventbrite organization; the plugin reads
# these through config/app_default.php, one per knob:

# Personal token (https://www.eventbrite.com/account-settings/apps). For apps that
# skip OAuth and for the eventbrite commands without --owner.
export EVENTBRITE_TOKEN=""

# Key for encrypting stored tokens. Any non-empty random string; generate with
# bin2hex(random_bytes(16)). No default by design (see docs/eventbrite-plugin-design.md).
export EVENTBRITE_ENCRYPTION_KEY=""

# OAuth app credentials (same page as the private token):
#   "API key"        -> EVENTBRITE_OAUTH_CLIENT_ID
#   "Client secret"  -> EVENTBRITE_OAUTH_CLIENT_SECRET
# The redirect URI must exactly match one registered in the app settings.
export EVENTBRITE_OAUTH_CLIENT_ID=""
export EVENTBRITE_OAUTH_CLIENT_SECRET=""
export EVENTBRITE_OAUTH_REDIRECT_URI=""

# Public base URL of the host app — webhook registrations point at
# {base}/eventbrite/webhook/{secret} under it.
export EVENTBRITE_WEBHOOK_BASE_URL=""
